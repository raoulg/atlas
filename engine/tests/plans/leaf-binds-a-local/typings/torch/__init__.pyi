class Tensor:
    def abs(self) -> Tensor: ...
    def all(self) -> Tensor: ...
    def __gt__(self, other: float) -> Tensor: ...
    def __eq__(self, other: object) -> Tensor: ...  # type: ignore[override]
    def __and__(self, other: Tensor) -> Tensor: ...
    def __invert__(self) -> Tensor: ...
    def __mul__(self, other: Tensor) -> Tensor: ...
