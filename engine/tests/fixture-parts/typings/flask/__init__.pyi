from typing import Any, Callable, TypeVar

F = TypeVar("F", bound=Callable[..., Any])

class Scaffold:
    def route(self, rule: str, **options: Any) -> Callable[[F], F]: ...
    def get(self, rule: str, **options: Any) -> Callable[[F], F]: ...
    def post(self, rule: str, **options: Any) -> Callable[[F], F]: ...

class Flask(Scaffold):
    def __init__(self, import_name: str) -> None: ...

class Blueprint(Scaffold):
    def __init__(self, name: str, import_name: str, url_prefix: str | None = None) -> None: ...
