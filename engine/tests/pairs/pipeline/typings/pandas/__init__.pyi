from collections.abc import Hashable, Sequence
from os import PathLike
from typing import Any

class Index: ...

class Rolling:
    def mean(self) -> Series: ...

class Series:
    index: Index
    def __getitem__(self, key: Any) -> Any: ...
    def __eq__(self, other: object) -> Series: ...  # type: ignore[override]
    def __ne__(self, other: object) -> Series: ...  # type: ignore[override]
    def __add__(self, other: Any) -> Series: ...
    def astype(self, dtype: Any) -> Series: ...
    def rolling(self, window: int, center: bool = False, min_periods: int | None = None) -> Rolling: ...

class DataFrame:
    columns: Any
    index: Index
    def __init__(self, data: Any = None, **kwargs: Any) -> None: ...
    def __getitem__(self, key: Any) -> Any: ...
    def __setitem__(self, key: Any, value: Any) -> None: ...
    def assign(self, **kwargs: Any) -> DataFrame: ...
    def set_index(self, keys: Any, **kwargs: Any) -> DataFrame: ...
    def dropna(self, *, subset: Sequence[Hashable] | None = None, inplace: bool = False) -> DataFrame: ...
    def drop(self, labels: Any = None, *, inplace: bool = False, **kwargs: Any) -> DataFrame: ...
    def reset_index(self, *, drop: bool = False, inplace: bool = False) -> DataFrame: ...
    def describe(self) -> DataFrame: ...
    def to_string(self) -> str: ...

def read_csv(
    filepath_or_buffer: str | PathLike[str],
    *,
    sep: str = ",",
    header: int | None = 0,
    names: Sequence[str] | None = None,
    na_values: Any = None,
    **kwargs: Any,
) -> DataFrame: ...
def to_datetime(arg: Any, **kwargs: Any) -> Series: ...
