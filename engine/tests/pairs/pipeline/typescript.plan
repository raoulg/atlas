line cli.ts/main/trend/?1/line > _·path@cli.ts/main/trend/?1/line value
line _·path@cli.ts/main/trend/?1/line > cli.ts/main/trend value   # `path(series)`, `path(smoothed)`
line _·x@cli.ts/main/trend/?1/range > cli.ts/main/trend/?1/map value          # `x.ticks(10)`, `x(t)`
