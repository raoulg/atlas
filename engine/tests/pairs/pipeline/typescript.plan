# The TypeScript command names the records it keeps and hands them from step to step, and draws the figure as a
# document: `trend` gives the SVG as a string, which `saveSvg` writes where the command line says. The command's own
# code runs `main`, which parses its command line into `values`, whose fields name the places; the raw file is filled
# only where it is missing, so it stands between the download and the reading.

route sunspots.cli
step cli.ts/main
step cli.ts/main/parseArgs                                        # `const { values } = parseArgs(..)`, taken to the entry
step cli.ts/main/monthsOf
choice cli.ts/main/monthsOf/?1                                    # `if (option === undefined) return ..`: what follows is its other arm
step cli.ts/main/monthsOf/?1/Number                                  # `const months = Number(option)`
step cli.ts/main/Settings()                                       # `const settings: Settings = { .. }`
choice cli.ts/main/?1
step cli.ts/main/?1/download
step cli.ts/main/?1/download/fetch                                # `const response = await fetch(..)`
step cli.ts/main/load
step cli.ts/main/load/parse
step cli.ts/main/load/parse/parseLine                             # `.map(parseLine)` runs it on each line
step cli.ts/main/load/parse/parseLine/map                         # `const fields = line.split(";").map(Number)`
choice cli.ts/main/load/parse/parseLine/?1                        # `if (..) throw ..`: what follows is its other arm
step cli.ts/main/load/parse/parseLine/?1/Month()          # `return { date, mean, std, observations }`, a Month
step cli.ts/main/smooth
step cli.ts/main/smooth/floor                                     # `const before = Math.floor(months / 2)`
step cli.ts/main/smooth/average
step cli.ts/main/trend
step cli.ts/main/trend/at                                  # `const last = series.at(-1)`
choice cli.ts/main/trend/?1                                       # `if (first === undefined || ..) throw ..`
step cli.ts/main/trend/?1/range                                      # `const x = scaleUtc()..range(..)`
step cli.ts/main/trend/?1/range#2                                    # `const y = scaleLinear()..range(..)`
step cli.ts/main/trend/?1/line                                       # `const path = line<Smoothed>(..)`
step cli.ts/main/trend/?1/map                                        # `const years = x.ticks(10).map(..)`
step cli.ts/main/trend/?1/map#2                                      # `const counts = y.ticks(5).map(..)`
step cli.ts/main/trend/?1/escape
step cli.ts/main/saveSvg

line entry > cli.ts call
line entry > cli.ts/main/parseArgs call                           # the command line is what the parse reads
line cli.ts/main/parseArgs > _·values@cli.ts/main/parseArgs value

line _·values@cli.ts/main/parseArgs > cli.ts/main/monthsOf value         # `values.months`, checked
known #128 line _·values@cli.ts/main/parseArgs > cli.ts/main/monthsOf/?1/Number value   # `Number(option)`: `option` holds what fills it, `{"at": 0}`
known #128 line Settings·DEFAULT_SETTINGS > cli.ts/main/monthsOf value   # `return DEFAULT_SETTINGS.months`: the body's own use of a module's value
line cli.ts/main/monthsOf/?1/Number > _·months@cli.ts/main/monthsOf/?1/Number value
line _·months@cli.ts/main/monthsOf/?1/Number > cli.ts/main/monthsOf value   # `return months`
line cli.ts/main/monthsOf > _@cli.ts/main/monthsOf value
line _@cli.ts/main/monthsOf > cli.ts/main/Settings() value
line Settings·DEFAULT_SETTINGS > cli.ts/main/Settings() value            # `...DEFAULT_SETTINGS`
line cli.ts/main/Settings() > Settings·settings@cli.ts/main/Settings() value

line _·values@cli.ts/main/parseArgs > cli.ts/main/?1/download value      # `values.raw`
