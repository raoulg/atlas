line _·before@cli.ts/main/smooth/floor > cli.ts/main/smooth value   # `series.slice(before, ..)`
line Month·series@cli.ts/main/load > cli.ts/main/smooth/average value # handed series.slice(..), which is no step
line cli.ts/main/smooth/average > cli.ts/main/smooth back # the mean goes into the Smoothed `smooth` makes; `map`, no step, takes it
