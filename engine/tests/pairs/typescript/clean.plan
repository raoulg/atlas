# Morphisms are functions: what a value is, is what the arrow that makes it gives. The file's JSON comes in as the
# world has it, and `parseConfig(raw: unknown): Config` turns it into the program's own type, once.

# An error a call into a family hands on (`this.rates.latest(..)`, which runs `HttpRates.latest` or `FileRates.latest`) is
# made inside the step, at the moment of the choice it is, and its border hands on a value of its own (#138).

route expenses.config.loadConfig
step loadConfig/parseConfig
step loadConfig/parseConfig/fieldsOf
step loadConfig/parseConfig/get                                    # const currency = fields.get("currency")
step loadConfig/parseConfig/get#2                                  # const categories = fields.get("categories")
step loadConfig/parseConfig/isCurrency
choice loadConfig/parseConfig/?1                                     # `if (!isCurrency(..)) throw ..`: what follows is its other arm
step loadConfig/parseConfig/?1/Config()                                      # return { currency, categories }, a Config

line entry > loadConfig call
line Disk(loadConfig.file) > loadConfig own                              # the file the route is handed, read and parsed
line loadConfig/parseConfig/fieldsOf > _·fields@loadConfig/parseConfig/fieldsOf value   # a map of what is still to be checked
line _·fields@loadConfig/parseConfig/fieldsOf > loadConfig/parseConfig/get value
line _·fields@loadConfig/parseConfig/fieldsOf > loadConfig/parseConfig/get#2 value
line loadConfig/parseConfig/get > _·currency@loadConfig/parseConfig/get value
line loadConfig/parseConfig/get#2 > _·categories@loadConfig/parseConfig/get#2 value
line _·currency@loadConfig/parseConfig/get > loadConfig/parseConfig/isCurrency value
line loadConfig/parseConfig/isCurrency > loadConfig/parseConfig back     # whether the currency is one decides the throw
# parseConfig builds the Config of what it checked, and checks the categories itself (`Array.isArray`, `every`):
# `categories.every(..)` runs on what `Array.isArray` narrowed to an array, a library operation whose result is named by
# nothing and that changes nothing, so no occurrence, and the `||` around it no frame
line _·currency@loadConfig/parseConfig/get > loadConfig/parseConfig/?1/Config() value
line _·categories@loadConfig/parseConfig/get#2 > loadConfig/parseConfig/?1/Config() value
line loadConfig/parseConfig/?1/Config() > Config@loadConfig/parseConfig/?1/Config() value
line Config@loadConfig/parseConfig/?1/Config() > loadConfig/parseConfig value
line loadConfig/parseConfig > Config@loadConfig/parseConfig value
line Config@loadConfig/parseConfig > loadConfig value                    # loadConfig hands back what parseConfig made
line loadConfig > Config@loadConfig value                                # and gives it, at its moment

home _·fields@loadConfig/parseConfig/fieldsOf loadConfig/parseConfig
home _·currency@loadConfig/parseConfig/get loadConfig/parseConfig
home _·categories@loadConfig/parseConfig/get#2 loadConfig/parseConfig
home Config@loadConfig/parseConfig/?1/Config() loadConfig/parseConfig
home Config@loadConfig/parseConfig loadConfig
home Config@loadConfig loadConfig

# The body's own test of the categories (`Array.isArray(categories)`, `categories.every(..)`, #101)
line _·categories@loadConfig/parseConfig/get#2 > loadConfig/parseConfig value

# An error is a value (#138): `throw new Error(..)` builds one in the arm that throws it, the errors the arms of one choice
# hand on are one value at the choice's moment, and each border it crosses uncaught hands it on, up to the route
choice loadConfig/parseConfig/fieldsOf/?1                                  # what is no object is an error
step loadConfig/parseConfig/fieldsOf/?1/Error()
step loadConfig/parseConfig/?1/Error()                                     # config: unknown currency
step loadConfig/parseConfig/?1/Error()#2                                   # config: categories must be a list of names
line _·currency@loadConfig/parseConfig/get > loadConfig/parseConfig/?1/Error() value   # `${String(currency)}`
line loadConfig/parseConfig/fieldsOf/?1/Error() > Error@loadConfig/parseConfig/fieldsOf/?1 value
line Error@loadConfig/parseConfig/fieldsOf/?1 > loadConfig/parseConfig/fieldsOf value
home Error@loadConfig/parseConfig/fieldsOf/?1 loadConfig/parseConfig/fieldsOf
line loadConfig/parseConfig/fieldsOf > Error@loadConfig/parseConfig/fieldsOf value
line Error@loadConfig/parseConfig/fieldsOf > loadConfig/parseConfig value
home Error@loadConfig/parseConfig/fieldsOf loadConfig/parseConfig
line loadConfig/parseConfig/?1/Error() > Error@loadConfig/parseConfig/?1 value
line loadConfig/parseConfig/?1/Error()#2 > Error@loadConfig/parseConfig/?1 value   # the other arm's, the same value
line Error@loadConfig/parseConfig/?1 > loadConfig/parseConfig value
home Error@loadConfig/parseConfig/?1 loadConfig/parseConfig
line loadConfig/parseConfig > Error@loadConfig/parseConfig value
line Error@loadConfig/parseConfig > loadConfig value
home Error@loadConfig/parseConfig loadConfig
line loadConfig > Error@loadConfig value
home Error@loadConfig loadConfig
# the error an arm throws stands at the constructor's moment, not the choice's

side entry left
side Disk(loadConfig.file) left
