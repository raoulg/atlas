# Morphisms are functions: a type no arrow gives is no type of the route. The shortcut asserts the type
# (`JSON.parse(..) as Config`): no step makes a Config, and the route reads its file and hands on what it parsed.

route shortcut.config.loadConfig
step loadConfig/parse                                                    # const config = JSON.parse(..) as Config

line entry > loadConfig call
line Disk(loadConfig.file) > loadConfig own
line loadConfig/parse > _·config@loadConfig/parse value                  # what JSON.parse gives has no type
known #101 line _·config@loadConfig/parse > loadConfig value             # loadConfig checks config.currency and returns it
line loadConfig > Config@loadConfig value                                # the Config the signature promises, made by no step

home _·config@loadConfig/parse loadConfig
home Config@loadConfig loadConfig

side entry left
side Disk(loadConfig.file) left
