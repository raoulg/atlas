# A lens on a table: `join` puts a Member into `members` and `member` gets one back from it; `latest` only gets a
# Report, which holds a Member, from `reports`. The place is the table the statement names. The route of the exported
# struct is its public functions, each called by its caller, run on the Register `new` built.

route club.desk.Register
step Register()/Register.new
known #74 step Register()/Register.new/Register()               # the struct built by its literal
step Register()/Register.join
step Register()/Register.member
step Register()/Register.member/Member()
step Register()/Register.latest
step Register()/Register.latest/Member()
step Register()/Register.latest/Report()

line entry > Register()/Register.new call
line entry > Register()/Register.join call
line entry > Register()/Register.member call
line entry > Register()/Register.latest call

known #74 line Connection·conn > Register()/Register.new/Register() value   # the literal is handed new's connection
line Register()/Register.new/Register() > Register@Register()/Register.new/Register() value
line Register@Register()/Register.new/Register() > Register()/Register.new value
line Register()/Register.new > Register@Register()/Register.new value
line Register@Register()/Register.new > Register()/Register.join value
line Register@Register()/Register.new > Register()/Register.member value
line Register@Register()/Register.new > Register()/Register.latest value

known #new line Member·who > Register()/Register.join value     # new-A
line Register()/Register.join > SQLite(members) own

line SQLite(members) > Register()/Register.member own
line Register()/Register.member/Member() > Member@Register()/Register.member/Member() value
line Member@Register()/Register.member/Member() > Register()/Register.member value
line Register()/Register.member > Member@Register()/Register.member value

line SQLite(reports) > Register()/Register.latest own
line Register()/Register.latest/Member() > Member@Register()/Register.latest/Member() value
line Member@Register()/Register.latest/Member() > Register()/Register.latest/Report() value   # the author
line Register()/Register.latest/Report() > Report@Register()/Register.latest/Report() value
line Report@Register()/Register.latest/Report() > Register()/Register.latest value
line Register()/Register.latest > Report@Register()/Register.latest value

known #new home Connection·conn Register()
home Register@Register()/Register.new/Register() Register()/Register.new
home Register@Register()/Register.new Register()
known #new home Member·who Register()
home Member@Register()/Register.member/Member() Register()/Register.member
home Member@Register()/Register.member Register()
home Member@Register()/Register.latest/Member() Register()/Register.latest
home Report@Register()/Register.latest/Report() Register()/Register.latest
home Report@Register()/Register.latest Register()

side entry left
side SQLite(members) between
side SQLite(reports) left

# building the exported struct runs its public functions, `new` among them, so the literal is read as recursive
known #74 extra step Register()/Register.new/Register() recursive
# new-A: the parameters of a function the entry calls have lost their names
known #new extra line Member > Register()/Register.join value
known #new extra home Member Register()
known #new extra home Connection Register()
# the recursive literal is cut, so new's connection ends at new's border
known #74 extra line Connection > Register()/Register.new value
# new-B: an opened step's own arrow takes every class its steps build: latest gives back the Report, not its author
known #new extra line Member@Register()/Register.latest/Member() > Register()/Register.latest value
