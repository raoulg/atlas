# `spend`, as it is written under time pressure: the command line is strings and `run(kind, args)` tests `kind` again
# after its `match`; the settings and the rates are maps of no type of the program's, the rates of a report go
# through a global, and the report reads the store itself. The places are decided in the library, each an
# environment variable with a fallback: one input, drawn as its default, which whoever starts the program may set.
#
# Touches stay with the function whose body makes them. Of a chain of library operations the last, whose result the
# body names, is the step; what the others give goes into it.

route spend.main
step main/collect                                                      # env::args().skip(1).collect()
step main/first   # match args.first() { Some(kind) => .. }
choice main/?1
step main/?1/run
step main/?1/run/load
step main/?1/run/load/unwrap_or_else
step main/?1/run/load/expect
step main/?1/run/Store.open
step main/?1/run/Store.open/unwrap_or_else
step main/?1/run/Store.open/unwrap
step main/?1/run/Store.open/Store()
choice main/?1/run/?1
step main/?1/run/?1/read_csv
step main/?1/run/?1/read_csv/unwrap
step main/?1/run/?1/read_csv/Expense.parse
step main/?1/run/?1/read_csv/Expense.parse/collect
step main/?1/run/?1/read_csv/Expense.parse/split_amount
step main/?1/run/?1/read_csv/Expense.parse/split_amount/unwrap_or      # `let (amount, currency) = ..split_once(' ').unwrap_or((text, "EUR"))`
step main/?1/run/?1/read_csv/Expense.parse/Expense()
step main/?1/run/?1/Store.save
step main/?1/run/?1/Store.save/round2
step main/?1/run/?1/fetch
step main/?1/run/?1/Store.save_rates
choice main/?1/run/?1/Store.save_rates/?1
step main/?1/run/?1/Store.save_rates/?1/unwrap_or_default
step main/?1/run/?1/Store.rates
step main/?1/run/?1/Store.rates/unwrap
step main/?1/run/?1/remember
step main/?1/run/?1/unwrap_or                                          # args.first().map(String::as_str).unwrap_or("md")
step main/?1/run/?1/write
choice main/?1/run/?1/write/?1
step main/?1/run/?1/write/?1/from
step main/?1/run/?1/write/Store.rows
step main/?1/run/?1/write/Store.rows/unwrap
step main/?1/run/?1/write/to_base
step main/?1/run/?1/write/round2
step main/?1/run/?1/write/from
step main/?1/run/?1/write/join
choice main/?1/run/?2
step main/?1/run/?2/Store.rows
step main/?1/run/?2/Store.rows/unwrap

