# `spend`, as a reviewer approves it: the command is chosen once (`match cli.command`, a choice of three arms), the
# settings, the rates and the report's lines are values of the program's own types handed from step to step, the
# report's formats are a family (`Render`), and every place is named in `main` and handed down.
#
# Touches stay with the function whose body makes them, also where a library operation there is a step of its own.
# A value made in one arm of a choice and taken only in that arm has the moment of the step that made it; the choice's
# moment is for a value that leaves the choice (`Format::renderer`'s match).

route spend.main
step main/Cli()                                                                # Cli::parse(): the command line
step main/Config.load
step main/Config.load/read_to_string
step main/Store.open
step main/Store.open/open
step main/Store.open/Store()
choice main/?1
step main/?1/read_csv
step main/?1/read_csv/read_to_string
step main/?1/read_csv/Expense.parse
step main/?1/read_csv/Expense.parse/splitn
step main/?1/read_csv/Expense.parse/next   # let (Some(date), Some(description), Some(amount)) =
step main/?1/read_csv/Expense.parse/next#2   # (fields.next(), fields.next(), fields.next())
step main/?1/read_csv/Expense.parse/next#3
choice main/?1/read_csv/Expense.parse/?1   # .. else { return Err(Error::Line(..)) }: the rest runs otherwise
step main/?1/read_csv/Expense.parse/?1/Error()
step main/?1/read_csv/Expense.parse/?1/Money.parse
step main/?1/read_csv/Expense.parse/?1/Money.parse/ok_or_else   # let (amount, currency) = ..ok_or_else(wrong)?
step main/?1/read_csv/Expense.parse/?1/Money.parse/map_err                        # let value: f64 = amount.parse().map_err(..)?
step main/?1/read_csv/Expense.parse/?1/Money.parse/Error()                        # the closure `wrong`
step main/?1/read_csv/Expense.parse/?1/Money.parse/Money()
step main/?1/read_csv/Expense.parse/?1/Expense()
step main/?1/Store.save
step main/?1/RatesClient.new
step main/?1/RatesClient.new/RatesClient()
step main/?1/RatesClient.latest
step main/?1/RatesClient.latest/error_for_status
step main/?1/Store.save_rates
step main/?1/Store.rates
step main/?1/Store.rates/prepare
step main/?1/Store.rates/query_map
step main/?1/Store.rates/Rates()
step main/?1/Store.rates/insert
choice main/?1/Store.rates/?1
step main/?1/Store.rates/?1/Error()
step main/?1/Store.expenses
step main/?1/Store.expenses/prepare
step main/?1/Store.expenses/query_map
step main/?1/Store.expenses/Money()
step main/?1/Store.expenses/Expense()
step main/?1/lines
step main/?1/lines/Rates.to_base
step main/?1/lines/ok_or_else
step main/?1/lines/Error()
step main/?1/lines/Money()
step main/?1/lines/Line()
step main/?1/lines/push   # out.push(Line { .. }) on `let mut out = vec![]`
step main/?1/Format.renderer
choice main/?1/Format.renderer/?1
step main/?1/Format.renderer/?1/Markdown()
step main/?1/Format.renderer/?1/Csv()
step main/?1/write
step main/?1/write/Render.extension
step main/?1/write/Render.extension/Markdown.extension
step main/?1/write/Render.extension/Csv.extension
step main/?1/write/join
step main/?1/write/Render.render
step main/?1/write/Render.render/Markdown.render
step main/?1/write/Render.render/Csv.render
step main/?1/write/Render.render/Csv.render/from

