# A job run in one of two modes. Each choice is made once, in a place with a name: what a mode means is `Mode::plan`,
# one match building a Plan in either arm, called wherever a mode's plan is wanted; where the job comes from is the
# body of `source`; `report` builds its Message by one struct expression in either arm, the level's own method marking
# it. The settings are the route's own value: a call handed `settings.mode` or `settings.level` is handed the
# settings, the projection glued into the call; inside, the parameter that holds the field is the value its steps take.

route runs.run
step run/source
choice run/source/?1
step run/source/?1/load
step run/source/?1/load/Job()
step run/source/?1/infer
step run/source/?1/infer/Job()
step run/finished
step run/finished/Runner.new
step run/finished/Runner.new/Mode.plan
choice run/finished/Runner.new/Mode.plan/?1
step run/finished/Runner.new/Mode.plan/?1/Plan()
step run/finished/Runner.new/Mode.plan/?1/Plan()#2
step run/finished/Runner.new/Runner()                            # the struct expression `new` builds it by
step run/finished/Runner.batch
step run/finished/Mode.plan
choice run/finished/Mode.plan/?1
step run/finished/Mode.plan/?1/Plan()
step run/finished/Mode.plan/?1/Plan()#2
step run/report
choice run/report/?1
step run/report/?1/Level.prefix
step run/report/?1/Message()
step run/report/?1/Level.suffix
step run/report/?1/Message()#2
step run/report/send
step run/Mode.plan
choice run/Mode.plan/?1
step run/Mode.plan/?1/Plan()
step run/Mode.plan/?1/Plan()#2

line entry > run call
line Settings·settings > run value                                 # run reads the mode and the level from it

# where the job comes from
line run/source/?1/load/Job() > Job@run/source/?1/load/Job() value
line Job@run/source/?1/load/Job() > run/source/?1/load value
line run/source/?1/load > Job@run/source/?1 value
line run/source/?1/infer/Job() > Job@run/source/?1/infer/Job() value
line Job@run/source/?1/infer/Job() > run/source/?1/infer value
line run/source/?1/infer > Job@run/source/?1 value
line Job@run/source/?1 > run/source value
line run/source > Job·job@run/source value
line Job·job@run/source > run/finished value
line Settings·settings > run/finished value                       # its mode, held by finished's `mode`
line Settings·settings > run/report value                         # its level, held by report's `level`

# whether it finished: a Runner built on the mode's plan, and the timeout of that plan
line Mode·mode > run/finished/Runner.new/Mode.plan value            # new hands the mode to Mode::plan
line run/finished/Runner.new/Mode.plan/?1/Plan() > Plan@run/finished/Runner.new/Mode.plan/?1 value
line run/finished/Runner.new/Mode.plan/?1/Plan()#2 > Plan@run/finished/Runner.new/Mode.plan/?1 value
line Plan@run/finished/Runner.new/Mode.plan/?1 > run/finished/Runner.new/Mode.plan value
line run/finished/Runner.new/Mode.plan > Plan@run/finished/Runner.new/Mode.plan value
line Plan@run/finished/Runner.new/Mode.plan > run/finished/Runner.new/Runner() value
line run/finished/Runner.new/Runner() > Runner@run/finished/Runner.new/Runner() value
line Runner@run/finished/Runner.new/Runner() > run/finished/Runner.new value
line run/finished/Runner.new > Runner@run/finished/Runner.new value
line Runner@run/finished/Runner.new > run/finished/Runner.batch value
line run/finished/Runner.batch > run/finished back
line Mode·mode > run/finished/Mode.plan value
line run/finished/Mode.plan/?1/Plan() > Plan@run/finished/Mode.plan/?1 value
line run/finished/Mode.plan/?1/Plan()#2 > Plan@run/finished/Mode.plan/?1 value
line Plan@run/finished/Mode.plan/?1 > run/finished/Mode.plan value
line run/finished/Mode.plan > Plan@run/finished/Mode.plan value
line Plan@run/finished/Mode.plan > run/finished value               # finished reads its timeout
line run/finished > _@run/finished value                           # the bool, handed straight to report
line _@run/finished > run/report value

# the line that says how it went: what the level's method gives goes into the Message built around it
line Level·level > run/report/?1/Level.prefix value
line Level·level > run/report/?1/Level.suffix value
line run/report/?1/Level.prefix > _@run/report/?1/Level.prefix value
line _@run/report/?1/Level.prefix > run/report/?1/Message() value
line run/report/?1/Level.suffix > _@run/report/?1/Level.suffix value
line _@run/report/?1/Level.suffix > run/report/?1/Message()#2 value
line Job·job@run/source > run/report/?1/Message() value             # each Message writes its name
line Job·job@run/source > run/report/?1/Message()#2 value
line run/report/?1/Message() > Message·message@run/report/?1 value
line run/report/?1/Message()#2 > Message·message@run/report/?1 value
line Message·message@run/report/?1 > run/report/send value
line run/report/send > Screen own
line run/report/send > run/report back
line run/report > run back

# the retries of the mode's plan: Mode::plan is handed the settings, `.mode` glued into the call
line Settings·settings > run/Mode.plan value
line run/Mode.plan/?1/Plan() > Plan@run/Mode.plan/?1 value
line run/Mode.plan/?1/Plan()#2 > Plan@run/Mode.plan/?1 value
line Plan@run/Mode.plan/?1 > run/Mode.plan value
line run/Mode.plan > Plan@run/Mode.plan value
line Plan@run/Mode.plan > run value                                 # run reads its retries

home Settings·settings run
home Mode·mode run
home Level·level run
home Job@run/source/?1/load/Job() run/source/?1/load
home Job@run/source/?1/infer/Job() run/source/?1/infer
home Job@run/source/?1 run/source
home Job·job@run/source run
home Plan@run/finished/Runner.new/Mode.plan/?1 run/finished/Runner.new/Mode.plan
home Plan@run/finished/Runner.new/Mode.plan run/finished/Runner.new
home Runner@run/finished/Runner.new/Runner() run/finished/Runner.new
home Runner@run/finished/Runner.new run/finished
home Plan@run/finished/Mode.plan/?1 run/finished/Mode.plan
home Plan@run/finished/Mode.plan run/finished
home _@run/finished run
home _@run/report/?1/Level.prefix run/report/?1
home _@run/report/?1/Level.suffix run/report/?1
home Message·message@run/report/?1 run/report
home Plan@run/Mode.plan/?1 run/Mode.plan
home Plan@run/Mode.plan run

side entry left
side Screen right

# the field a call's argument reads is drawn as a nameless value of its own, beside the settings the call is handed
known #127 extra line Mode > run/Mode.plan value
known #127 extra home Mode run

# a name handed to a call nested in an argument counts as handed to the call around it too: `level` goes to
# `level.prefix()`, whose result the Message is built from, not to the Message
known #128 extra line Level·level > run/report/?1/Message() value
known #128 extra line Level·level > run/report/?1/Message()#2 value

# an opened step's own arrow takes what its steps make, or what its call is handed, though only a step inside takes it
known #126 extra line Job·job@run/source > run/report value
known #126 extra line Job·job@run/source > run value
