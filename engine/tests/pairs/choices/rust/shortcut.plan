# A job run in one of two modes, with the shortcut: where the job comes from is a choice between `load` and `infer`
# in the middle of `run`, between its other steps; the mode is a String, handed to each function that tests it again.

route runs.run
choice run/?1
step run/?1/load
step run/?1/load/Job()
step run/?1/infer
step run/?1/infer/Job()
step run/finished
step run/finished/Runner.new
step run/finished/Runner.new/Runner()                            # the struct expression `new` builds it by
step run/finished/Runner.batch
step run/finished/timeout
step run/prefix
step run/suffix
step run/Message()
step run/send
step run/retries
step run/verbosity

line entry > run call
line Settings·settings > run value
line Settings·settings > run/verbosity value

# where the job comes from, between the other steps
line run/?1/load/Job() > Job@run/?1/load/Job() value
line Job@run/?1/load/Job() > run/?1/load value
line run/?1/load > Job·job@run/?1 value
line run/?1/infer/Job() > Job@run/?1/infer/Job() value
line Job@run/?1/infer/Job() > run/?1/infer value
line run/?1/infer > Job·job@run/?1 value
line Settings·settings > run/finished value                       # its mode, a String, held by finished's `mode`
line Job·job@run/?1 > run/finished value                          # finished counts its steps
line Job·job@run/?1 > run value                                   # run writes its name into the text

# whether it finished
line run/finished/Runner.new/Runner() > Runner@run/finished/Runner.new/Runner() value
line Runner@run/finished/Runner.new/Runner() > run/finished/Runner.new value
line run/finished/Runner.new > Runner@run/finished/Runner.new value
line Runner@run/finished/Runner.new > run/finished/Runner.batch value
line run/finished/Runner.batch > run/finished back
line run/finished/timeout > run/finished back
line run/finished > _·done@run/finished value
known #101 line _·done@run/finished > run value                   # run chooses " done" or " failed" by it

# the line that says how it went: prefix and suffix are handed the settings, `.level` glued into each call
line Settings·settings > run/prefix value
line Settings·settings > run/suffix value
line run/prefix > run back
line run/suffix > run back
line run/Message() > Message@run/Message() value
line Message@run/Message() > run/send value
line run/send > Screen own
line run/send > run back
line Settings·settings > run/retries value
line run/retries > run back
line run/verbosity > run back

home Settings·settings run
home Job@run/?1/load/Job() run/?1/load
home Job@run/?1/infer/Job() run/?1/infer
home Job·job@run/?1 run
home Runner@run/finished/Runner.new/Runner() run/finished/Runner.new
home Runner@run/finished/Runner.new run/finished
home _·done@run/finished run
home Message@run/Message() run

side entry left
side Screen right

# the named bool goes back to run as well as being a value no step takes
known #134 extra line run/finished > run back

# the field a call's argument reads is drawn as a nameless value of its own, beside the settings the call is handed
known #127 extra line Level > run/prefix value
known #127 extra line Level > run/suffix value
known #127 extra home Level run

# an opened step's own arrow takes what its steps make, though only a step inside takes it
known #126 extra line Runner@run/finished/Runner.new > run/finished value
known #126 extra line Message@run/Message() > run value
