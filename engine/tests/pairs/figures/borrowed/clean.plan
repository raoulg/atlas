# A board borrows another chart's figure for its left part. The caller draws a line on the first chart, which makes the
# figure that chart holds; the board, handed two charts that hold none, borrows it: `lender.lend(self.left)` fills `lend`'s
# `other` with the board through `left` (#172), and inside it `other.take(self.fig, self.ax)` sets the left part's fields to
# the first chart's. A change made through a part changes its owner, a lens's put: `lend` gives the board anew, and no chart
# of its own (#181). The board's left part is the chart set into it (#179), which from then on holds the first chart's
# figure; its right part makes one of its own. Two figures, each named where it is made.

route notebooks.side_by_side
step side_by_side/side_by_side
step side_by_side/side_by_side/Chart()
step side_by_side/side_by_side/Chart.line
choice side_by_side/side_by_side/Chart.line/?1
step side_by_side/side_by_side/Chart.line/?1/Chart.create_figure
step side_by_side/side_by_side/Chart()#2
step side_by_side/side_by_side/Chart()#3
step side_by_side/side_by_side/Board()
step side_by_side/side_by_side/Board.borrow
step side_by_side/side_by_side/Board.borrow/Chart.lend
step side_by_side/side_by_side/Board.borrow/Chart.lend/Chart.take
step side_by_side/side_by_side/Board.draw
step side_by_side/side_by_side/Board.draw/Chart.line
choice side_by_side/side_by_side/Board.draw/Chart.line/?1
step side_by_side/side_by_side/Board.draw/Chart.line/?1/Chart.create_figure
step side_by_side/side_by_side/Board.draw/Chart.line#2
choice side_by_side/side_by_side/Board.draw/Chart.line#2/?1
step side_by_side/side_by_side/Board.draw/Chart.line#2/?1/Chart.create_figure

line entry > side_by_side call

# the first chart's line makes its figure, where it holds none
line side_by_side/side_by_side/Chart() > Chart·first@side_by_side/side_by_side/Chart() value
line Chart·first@side_by_side/side_by_side/Chart() > side_by_side/side_by_side/Chart.line/?1/Chart.create_figure value
line side_by_side/side_by_side/Chart.line/?1/Chart.create_figure > Chart·self@side_by_side/side_by_side/Chart.line/?1 value
line side_by_side/side_by_side/Chart.line/?1/Chart.create_figure > Figure 1 · Chart · first own   # `plt.subplots()`
line Chart·self@side_by_side/side_by_side/Chart.line/?1 > side_by_side/side_by_side/Chart.line value   # `self.ax.plot(..)`
line side_by_side/side_by_side/Chart.line > Chart·first@side_by_side/side_by_side/Chart.line value

# the board, handed two charts that hold no figure
line side_by_side/side_by_side/Chart()#2 > Chart@side_by_side/side_by_side/Chart()#2 value
line side_by_side/side_by_side/Chart()#3 > Chart@side_by_side/side_by_side/Chart()#3 value
line Chart@side_by_side/side_by_side/Chart()#2 > side_by_side/side_by_side/Board() value        # `self.left = left`
line Chart@side_by_side/side_by_side/Chart()#3 > side_by_side/side_by_side/Board() value        # `self.right = right`
line side_by_side/side_by_side/Board() > Board·board@side_by_side/side_by_side/Board() value

# it borrows the first chart's figure: `take` runs on the board through `left`, handed the first chart's fields, and `lend`
# gives the board anew
line Board·board@side_by_side/side_by_side/Board() > side_by_side/side_by_side/Board.borrow/Chart.lend/Chart.take value
line Chart·first@side_by_side/side_by_side/Chart.line > side_by_side/side_by_side/Board.borrow/Chart.lend/Chart.take value
line side_by_side/side_by_side/Board.borrow/Chart.lend/Chart.take > Chart·other@side_by_side/side_by_side/Board.borrow/Chart.lend/Chart.take value   # `self.fig, self.ax = fig, ax`
line Chart·other@side_by_side/side_by_side/Board.borrow/Chart.lend/Chart.take > side_by_side/side_by_side/Board.borrow/Chart.lend value
line side_by_side/side_by_side/Board.borrow/Chart.lend > Board·self@side_by_side/side_by_side/Board.borrow/Chart.lend value
line Board·self@side_by_side/side_by_side/Board.borrow/Chart.lend > side_by_side/side_by_side/Board.borrow value
line side_by_side/side_by_side/Board.borrow > Board·board@side_by_side/side_by_side/Board.borrow value

# the left part draws on the figure it borrowed
line Board·board@side_by_side/side_by_side/Board.borrow > side_by_side/side_by_side/Board.draw/Chart.line/?1/Chart.create_figure value
line side_by_side/side_by_side/Board.draw/Chart.line/?1/Chart.create_figure > Chart·self@side_by_side/side_by_side/Board.draw/Chart.line/?1 value
line side_by_side/side_by_side/Board.draw/Chart.line/?1/Chart.create_figure > Figure 1 · Chart · first own
line Chart·self@side_by_side/side_by_side/Board.draw/Chart.line/?1 > side_by_side/side_by_side/Board.draw/Chart.line value
line side_by_side/side_by_side/Board.draw/Chart.line > Board·self@side_by_side/side_by_side/Board.draw/Chart.line value

# the right part makes a figure of its own
line Board·self@side_by_side/side_by_side/Board.draw/Chart.line > side_by_side/side_by_side/Board.draw/Chart.line#2/?1/Chart.create_figure value
line side_by_side/side_by_side/Board.draw/Chart.line#2/?1/Chart.create_figure > Chart·self@side_by_side/side_by_side/Board.draw/Chart.line#2/?1 value
line side_by_side/side_by_side/Board.draw/Chart.line#2/?1/Chart.create_figure > Figure 2 · Board · board.right own
line Chart·self@side_by_side/side_by_side/Board.draw/Chart.line#2/?1 > side_by_side/side_by_side/Board.draw/Chart.line#2 value
line side_by_side/side_by_side/Board.draw/Chart.line#2 > Board·self@side_by_side/side_by_side/Board.draw/Chart.line#2 value
line Board·self@side_by_side/side_by_side/Board.draw/Chart.line#2 > side_by_side/side_by_side/Board.draw value   # what its steps made of the board
line side_by_side/side_by_side/Board.draw > Board·board@side_by_side/side_by_side/Board.draw value
line Board·board@side_by_side/side_by_side/Board.draw > side_by_side/side_by_side value     # `return board`
line side_by_side/side_by_side > Board·board@side_by_side/side_by_side value                 # `board = side_by_side(..)`

home Chart·first@side_by_side/side_by_side/Chart() side_by_side/side_by_side
