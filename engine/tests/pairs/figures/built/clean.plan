# A board handed its charts. `side_by_side` builds the two charts and hands them to `Board(..)`, whose initializer keeps
# each in a field (`self.left = left`): building the board takes the charts. The board then draws each chart by the
# chart's own `line`, which runs on the board through the field (#172), so each figure rests in that part of the board:
# two, named by the part that holds each.

route notebooks.side_by_side
step side_by_side/side_by_side
step side_by_side/side_by_side/Chart()
step side_by_side/side_by_side/Chart()#2
step side_by_side/side_by_side/Board()
step side_by_side/side_by_side/Board.draw
step side_by_side/side_by_side/Board.draw/Chart.line
choice side_by_side/side_by_side/Board.draw/Chart.line/?1
step side_by_side/side_by_side/Board.draw/Chart.line/?1/Chart.create_figure
step side_by_side/side_by_side/Board.draw/Chart.line#2
choice side_by_side/side_by_side/Board.draw/Chart.line#2/?1
step side_by_side/side_by_side/Board.draw/Chart.line#2/?1/Chart.create_figure

line entry > side_by_side call
line side_by_side/side_by_side/Chart() > Chart@side_by_side/side_by_side/Chart() value
line side_by_side/side_by_side/Chart()#2 > Chart@side_by_side/side_by_side/Chart()#2 value
line Chart@side_by_side/side_by_side/Chart() > side_by_side/side_by_side/Board() value        # `self.left = left`
line Chart@side_by_side/side_by_side/Chart()#2 > side_by_side/side_by_side/Board() value      # `self.right = right`
line side_by_side/side_by_side/Board() > Board·board@side_by_side/side_by_side/Board() value

line Board·board@side_by_side/side_by_side/Board() > side_by_side/side_by_side/Board.draw/Chart.line/?1/Chart.create_figure value
line side_by_side/side_by_side/Board.draw/Chart.line/?1/Chart.create_figure > Chart·self@side_by_side/side_by_side/Board.draw/Chart.line/?1 value
line side_by_side/side_by_side/Board.draw/Chart.line/?1/Chart.create_figure > Figure 1 · Board · board.left own
line Chart·self@side_by_side/side_by_side/Board.draw/Chart.line/?1 > side_by_side/side_by_side/Board.draw/Chart.line value
line side_by_side/side_by_side/Board.draw/Chart.line > Board·self@side_by_side/side_by_side/Board.draw/Chart.line value

line Board·self@side_by_side/side_by_side/Board.draw/Chart.line > side_by_side/side_by_side/Board.draw/Chart.line#2/?1/Chart.create_figure value
line side_by_side/side_by_side/Board.draw/Chart.line#2/?1/Chart.create_figure > Chart·self@side_by_side/side_by_side/Board.draw/Chart.line#2/?1 value
line side_by_side/side_by_side/Board.draw/Chart.line#2/?1/Chart.create_figure > Figure 2 · Board · board.right own
line Chart·self@side_by_side/side_by_side/Board.draw/Chart.line#2/?1 > side_by_side/side_by_side/Board.draw/Chart.line#2 value
line side_by_side/side_by_side/Board.draw/Chart.line#2 > Board·self@side_by_side/side_by_side/Board.draw/Chart.line#2 value
line Board·self@side_by_side/side_by_side/Board.draw/Chart.line#2 > side_by_side/side_by_side/Board.draw value
line side_by_side/side_by_side/Board.draw > Board·board@side_by_side/side_by_side/Board.draw value
line Board·board@side_by_side/side_by_side/Board.draw > side_by_side/side_by_side value     # `return board`
line side_by_side/side_by_side > Board·board@side_by_side/side_by_side value                 # `board = side_by_side(..)`

home Chart@side_by_side/side_by_side/Chart() side_by_side/side_by_side
home Chart@side_by_side/side_by_side/Chart()#2 side_by_side/side_by_side
home Board·board@side_by_side/side_by_side/Board() side_by_side/side_by_side
home Chart·self@side_by_side/side_by_side/Board.draw/Chart.line/?1 side_by_side/side_by_side/Board.draw/Chart.line
home Board·self@side_by_side/side_by_side/Board.draw/Chart.line side_by_side/side_by_side/Board.draw
home Chart·self@side_by_side/side_by_side/Board.draw/Chart.line#2/?1 side_by_side/side_by_side/Board.draw/Chart.line#2
home Board·self@side_by_side/side_by_side/Board.draw/Chart.line#2 side_by_side/side_by_side/Board.draw
home Board·board@side_by_side/side_by_side/Board.draw side_by_side/side_by_side
home Board·board@side_by_side/side_by_side side_by_side

