# The same two charts, where `lend_title` reaches into the second chart and sets its title there (`other.title =
# self.title`). The field it sets is `title`, which holds no figure (#168): the second chart keeps its figure in `fig` and
# `ax`, which nothing sets to the first's, so its line makes one of its own and the screen shows two figures. What differs
# from the clean side is who sets the second chart's title: the first chart's `lend_title` itself, no step of the second's.

route notebooks.side_by_side
step side_by_side/side_by_side
step side_by_side/side_by_side/Chart()
step side_by_side/side_by_side/Chart()#2
step side_by_side/side_by_side/Chart.line
choice side_by_side/side_by_side/Chart.line/?1
step side_by_side/side_by_side/Chart.line/?1/Chart.create_figure
step side_by_side/side_by_side/Chart.lend_title
step side_by_side/side_by_side/Chart.line#2
choice side_by_side/side_by_side/Chart.line#2/?1
step side_by_side/side_by_side/Chart.line#2/?1/Chart.create_figure

line entry > side_by_side call
line side_by_side/side_by_side/Chart() > Chart·first@side_by_side/side_by_side/Chart() value
line side_by_side/side_by_side/Chart()#2 > Chart·second@side_by_side/side_by_side/Chart()#2 value

line Chart·first@side_by_side/side_by_side/Chart() > side_by_side/side_by_side/Chart.line/?1/Chart.create_figure value
line side_by_side/side_by_side/Chart.line/?1/Chart.create_figure > Chart·self@side_by_side/side_by_side/Chart.line/?1 value
line side_by_side/side_by_side/Chart.line/?1/Chart.create_figure > Figure 1 · Chart · first own    # `plt.subplots()`
line Chart·self@side_by_side/side_by_side/Chart.line/?1 > side_by_side/side_by_side/Chart.line value   # `self.ax.plot(..)`
line side_by_side/side_by_side/Chart.line > Chart·first@side_by_side/side_by_side/Chart.line value

line Chart·first@side_by_side/side_by_side/Chart.line > side_by_side/side_by_side/Chart.lend_title value   # `self.title`
line Chart·second@side_by_side/side_by_side/Chart()#2 > side_by_side/side_by_side/Chart.lend_title value   # `other.title = ..`
line side_by_side/side_by_side/Chart.lend_title > Chart·second@side_by_side/side_by_side/Chart.lend_title value

line Chart·second@side_by_side/side_by_side/Chart.lend_title > side_by_side/side_by_side/Chart.line#2/?1/Chart.create_figure value
line side_by_side/side_by_side/Chart.line#2/?1/Chart.create_figure > Chart·self@side_by_side/side_by_side/Chart.line#2/?1 value
line side_by_side/side_by_side/Chart.line#2/?1/Chart.create_figure > Figure 2 · Chart · second own   # a figure of its own
line Chart·self@side_by_side/side_by_side/Chart.line#2/?1 > side_by_side/side_by_side/Chart.line#2 value
line side_by_side/side_by_side/Chart.line#2 > Chart·second@side_by_side/side_by_side/Chart.line#2 value
line Chart·second@side_by_side/side_by_side/Chart.line#2 > side_by_side/side_by_side value              # `return second`
line side_by_side/side_by_side > Chart·chart@side_by_side/side_by_side value                            # `chart = side_by_side(..)`

home Chart·first@side_by_side/side_by_side/Chart() side_by_side/side_by_side
