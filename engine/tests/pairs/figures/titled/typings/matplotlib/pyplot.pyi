from os import PathLike
from typing import Any

from matplotlib.axes import Axes
from matplotlib.figure import Figure

def figure(figsize: tuple[float, float] | None = None, **kwargs: Any) -> Figure: ...
def subplots(nrows: int = 1, ncols: int = 1, **kwargs: Any) -> tuple[Figure, Axes]: ...
def plot(*args: Any, **kwargs: Any) -> list[Any]: ...
def title(label: str, **kwargs: Any) -> Any: ...
def xlabel(xlabel: str, **kwargs: Any) -> Any: ...
def ylabel(ylabel: str, **kwargs: Any) -> Any: ...
def legend(*args: Any, **kwargs: Any) -> Any: ...
def savefig(fname: str | PathLike[str], **kwargs: Any) -> None: ...
def close(fig: Figure | str | None = None) -> None: ...
def show(**kwargs: Any) -> None: ...
