# The knowledge base with the shortcut: `graaf` gives the lines back as records of no type of the code's, so the Bron
# put by `voegToe` never comes back as a Node: no value of the code's leaves the get.

route kennis.bank.Kennisbank
step Kennisbank()/Kennisbank()
step Kennisbank()/Kennisbank.voegToe
step Kennisbank()/Kennisbank.voegToe/Kennisbank.write
step Kennisbank()/Kennisbank.graaf

line entry > Kennisbank()/Kennisbank() call
line entry > Kennisbank()/Kennisbank.voegToe call
line entry > Kennisbank()/Kennisbank.graaf call

# what the constructor builds goes back to the caller; the doors run on the caller's instance, one value from
# beyond, taken where a body reads its fields or calls on it
line Kennisbank()/Kennisbank() > Kennisbank@Kennisbank()/Kennisbank() value
line Kennisbank > Kennisbank()/Kennisbank.voegToe/Kennisbank.write value
line Kennisbank > Kennisbank()/Kennisbank.graaf value

line Bron·bron > Kennisbank()/Kennisbank.voegToe/Kennisbank.write value                    # what it is handed: `bron.uuid`, `bron.url` glue `bron` in
line Disk(Kennisbank.path) > Kennisbank()/Kennisbank.voegToe/Kennisbank.write own
line Kennisbank()/Kennisbank.voegToe/Kennisbank.write > Disk(Kennisbank.path) own

line Disk(Kennisbank.path) > Kennisbank()/Kennisbank.graaf own

home Kennisbank@Kennisbank()/Kennisbank() Kennisbank()
home Kennisbank Kennisbank()
home Bron·bron Kennisbank()

# the line split in three parts, each held by its name, which the arrow function `graaf` maps the lines by puts into a row
known #125 step Kennisbank()/Kennisbank.graaf/split
known #125 line Kennisbank()/Kennisbank.graaf/split > _·uuid@Kennisbank()/Kennisbank.graaf/split value
known #125 line Kennisbank()/Kennisbank.graaf/split > _·soort@Kennisbank()/Kennisbank.graaf/split value
known #125 line Kennisbank()/Kennisbank.graaf/split > _·tekst@Kennisbank()/Kennisbank.graaf/split value
known #125 line _·uuid@Kennisbank()/Kennisbank.graaf/split > Kennisbank()/Kennisbank.graaf value
known #125 line _·soort@Kennisbank()/Kennisbank.graaf/split > Kennisbank()/Kennisbank.graaf value
known #125 line _·tekst@Kennisbank()/Kennisbank.graaf/split > Kennisbank()/Kennisbank.graaf value
known #125 home _·uuid@Kennisbank()/Kennisbank.graaf/split Kennisbank()/Kennisbank.graaf
known #125 home _·soort@Kennisbank()/Kennisbank.graaf/split Kennisbank()/Kennisbank.graaf
known #125 home _·tekst@Kennisbank()/Kennisbank.graaf/split Kennisbank()/Kennisbank.graaf

side entry left
side Disk(Kennisbank.path) both
