known #new line _·tekst@Kennisbank()/Kennisbank.graaf/Kennisbank._row/split > Kennisbank()/Kennisbank.graaf/Kennisbank._row value
known #new home _·uuid@Kennisbank()/Kennisbank.graaf/Kennisbank._row/split Kennisbank()/Kennisbank.graaf/Kennisbank._row
known #new home _·soort@Kennisbank()/Kennisbank.graaf/Kennisbank._row/split Kennisbank()/Kennisbank.graaf/Kennisbank._row
known #new home _·tekst@Kennisbank()/Kennisbank.graaf/Kennisbank._row/split Kennisbank()/Kennisbank.graaf/Kennisbank._row

side entry left
known #new side Disk(self.path) both          # voeg_toe reads what the file held and changes it: Atlas says right

