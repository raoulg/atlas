# The knowledge base with the shortcut: `graaf` gives the lines back as rows, dicts of no type of the code's, so the
# Bron put by `voeg_toe` never comes back as a Node: no value of the code's leaves the get.

route kennis.bank.Kennisbank
step Kennisbank()/Kennisbank()
step Kennisbank()/Kennisbank.voeg_toe
step Kennisbank()/Kennisbank.voeg_toe/Kennisbank._write
step Kennisbank()/Kennisbank.graaf
step Kennisbank()/Kennisbank.graaf/Kennisbank._row

line entry > Kennisbank()/Kennisbank() call
line entry > Kennisbank()/Kennisbank.voeg_toe call
line entry > Kennisbank()/Kennisbank.graaf call

# the store the constructor builds, which the doors run on
line Kennisbank()/Kennisbank() > Kennisbank@Kennisbank()/Kennisbank() value
line Kennisbank@Kennisbank()/Kennisbank() > Kennisbank()/Kennisbank.voeg_toe/Kennisbank._write value
known #new line Kennisbank@Kennisbank()/Kennisbank() > Kennisbank()/Kennisbank.graaf value     # graaf reads self.path
line Kennisbank@Kennisbank()/Kennisbank() > Kennisbank()/Kennisbank.graaf/Kennisbank._row value

known #new line Bron·bron > Kennisbank()/Kennisbank.voeg_toe value
line Disk(self.path) > Kennisbank()/Kennisbank.voeg_toe/Kennisbank._write own
line Kennisbank()/Kennisbank.voeg_toe/Kennisbank._write > Disk(self.path) own

line Disk(self.path) > Kennisbank()/Kennisbank.graaf own
line Kennisbank()/Kennisbank.graaf/Kennisbank._row > Kennisbank()/Kennisbank.graaf back   # each row, a dict, goes back to graaf

home Kennisbank@Kennisbank()/Kennisbank() Kennisbank()
home Bron·bron Kennisbank()

# the line split in three parts, each held by its name, which `_row` puts into a row
known #new step Kennisbank()/Kennisbank.graaf/Kennisbank._row/split
known #new line Kennisbank()/Kennisbank.graaf/Kennisbank._row/split > _·uuid@Kennisbank()/Kennisbank.graaf/Kennisbank._row/split value
known #new line Kennisbank()/Kennisbank.graaf/Kennisbank._row/split > _·soort@Kennisbank()/Kennisbank.graaf/Kennisbank._row/split value
known #new line Kennisbank()/Kennisbank.graaf/Kennisbank._row/split > _·tekst@Kennisbank()/Kennisbank.graaf/Kennisbank._row/split value
