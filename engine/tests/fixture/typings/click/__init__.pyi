from typing import Any, Callable, TypeVar

F = TypeVar("F", bound=Callable[..., Any])

class Command:
    def __call__(self, *args: Any, **kwargs: Any) -> Any: ...

class Group(Command):
    def command(self, *args: Any, **kwargs: Any) -> Callable[[Callable[..., Any]], Command]: ...

def group(*args: Any, **kwargs: Any) -> Callable[[Callable[..., Any]], Group]: ...
def command(*args: Any, **kwargs: Any) -> Callable[[Callable[..., Any]], Command]: ...
def option(*args: Any, **kwargs: Any) -> Callable[[F], F]: ...
def echo(message: object = None, **kwargs: Any) -> None: ...
