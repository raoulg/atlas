from typing import Any

class DataFrame:
    def to_csv(self, path: Any = None, **kwargs: Any) -> None: ...
    def to_parquet(self, path: Any, **kwargs: Any) -> None: ...
    def copy(self) -> DataFrame: ...

def read_csv(path: Any, **kwargs: Any) -> DataFrame: ...
def read_parquet(path: Any, **kwargs: Any) -> DataFrame: ...
