from os import PathLike
from typing import Any

class DataFrame:
    def to_csv(self, path_or_buf: str | PathLike[str] | None = None, **kwargs: Any) -> None: ...
    def to_parquet(self, path: str | PathLike[str], **kwargs: Any) -> None: ...
    def to_sql(self, name: str, con: Any, **kwargs: Any) -> int | None: ...
    def copy(self) -> DataFrame: ...

def read_csv(filepath_or_buffer: str | PathLike[str], **kwargs: Any) -> DataFrame: ...
def read_parquet(path: str | PathLike[str], **kwargs: Any) -> DataFrame: ...
def read_sql(sql: str, con: Any, **kwargs: Any) -> DataFrame: ...
def read_sql_query(sql: str, con: Any, **kwargs: Any) -> DataFrame: ...
def read_sql_table(table_name: str, con: Any, **kwargs: Any) -> DataFrame: ...
