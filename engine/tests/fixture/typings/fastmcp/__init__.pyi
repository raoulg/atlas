from typing import Any, Callable, TypeVar

F = TypeVar("F", bound=Callable[..., Any])

class FastMCP:
    def __init__(self, name: str) -> None: ...
    def tool(self, fn: F) -> F: ...
    def prompt(self, name: str) -> Callable[[F], F]: ...
    def resource(self, uri: str) -> Callable[[F], F]: ...
