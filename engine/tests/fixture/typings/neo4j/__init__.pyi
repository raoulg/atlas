from enum import Enum
from typing import Any, Callable, Concatenate, Iterator, ParamSpec, TypeVar

T = TypeVar("T")
P = ParamSpec("P")

READ_ACCESS: str
WRITE_ACCESS: str

class RoutingControl(Enum):
    READ = "r"
    WRITE = "w"

class Record:
    def data(self) -> dict[str, Any]: ...

class Result:
    def __iter__(self) -> Iterator[Record]: ...
    def consume(self) -> Any: ...

class ManagedTransaction:
    def run(self, query: str, parameters: dict[str, Any] | None = None, **kwargs: Any) -> Result: ...

class Session:
    def __enter__(self) -> Session: ...
    def __exit__(self, *args: object) -> None: ...
    def run(self, query: str, parameters: dict[str, Any] | None = None, **kwargs: Any) -> Result: ...
    def execute_read(self, transaction_function: Callable[Concatenate[ManagedTransaction, P], T], *args: P.args, **kwargs: P.kwargs) -> T: ...
    def execute_write(self, transaction_function: Callable[Concatenate[ManagedTransaction, P], T], *args: P.args, **kwargs: P.kwargs) -> T: ...

class Driver:
    def session(self, **kwargs: Any) -> Session: ...
    def execute_query(self, query: str, parameters: dict[str, Any] | None = None, routing_: RoutingControl = ..., **kwargs: Any) -> tuple[list[Record], Any, list[str]]: ...
    def close(self) -> None: ...

class GraphDatabase:
    @staticmethod
    def driver(uri: str, **kwargs: Any) -> Driver: ...
