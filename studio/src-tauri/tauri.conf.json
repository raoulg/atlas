{
  "productName": "Atlas Studio",
  "identifier": "io.github.raoulg.atlas-studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Atlas Studio",
        "width": 1320,
        "height": 820,
        "minWidth": 850,
        "minHeight": 560,
        "tabbingIdentifier": "atlas-studio"
      }
    ]
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/atlas"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
